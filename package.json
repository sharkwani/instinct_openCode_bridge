{
  "name": "instinct-bridge",
  "version": "0.2.0",
  "description": "Poll-out bridge: supervising AI -> queue -> coding agent on your machine. No open ports, no deps.",
  "bin": {
    "bridge": "bin/bridge.js"
  },
  "scripts": {
    "init": "node bin/bridge.js init",
    "start": "node bin/bridge.js start",
    "test:security-public": "node --test test/security-redaction-public.test.js",
    "test:all": "node --test test/task-output.test.js test/instinct-status.test.js test/control-and-questions.test.js test/security-redaction-public.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1"
  }
}
